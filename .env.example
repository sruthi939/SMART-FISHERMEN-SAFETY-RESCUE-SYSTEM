# Environment Variables Configuration
NODE_ENV=development
PORT=5000
HOST=http://localhost:5000

# JWT Authentication Secret
JWT_SECRET=sfsrs_maritime_super_secret_jwt_key_2026

# Database Configuration (SQLite default for simple setup; Postgres support)
DB_TYPE=sqlite
DB_FILE=./database/sfsrs.db

# MQTT Broker (Optional / IoT Telemetry)
MQTT_BROKER=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_TELEMETRY=sfsrs/boat/+/telemetry
MQTT_TOPIC_EMERGENCY=sfsrs/boat/+/emergency

# Weather API Key (Mock / OpenWeatherMap)
WEATHER_API_KEY=mock_weather_key_sfsrs

# AI Model Service
AI_SERVICE_URL=http://localhost:5001
